# Firebase (클라이언트 노출 가능 — 실제 보안은 Security Rules 가 책임)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# 환경 식별 (development / preview / production)
EXPO_PUBLIC_APP_ENV=development

# Sentry (sentry.io 프로젝트에서 발급)
EXPO_PUBLIC_SENTRY_DSN=

# Maestro E2E 테스트 계정 (실제 값은 셸 환경 변수로만 지정 — 저장소에 적지 않음)
# Maestro 는 MAESTRO_ 로 시작하는 환경 변수를 플로우의 ${...} 로 읽는다.
MAESTRO_TWOWO_EMAIL_A=
MAESTRO_TWOWO_PASSWORD_A=
MAESTRO_TWOWO_EMAIL_B=
MAESTRO_TWOWO_PASSWORD_B=
