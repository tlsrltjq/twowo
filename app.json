{
  "expo": {
    "name": "둘다좋아",
    "slug": "twowo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "twowo",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shingiseop.twowo",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shingiseop.twowo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#FFFBF7"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/b2876cc9-17db-46e8-876d-06ee39f442b8"
    },
    "plugins": [
      ["@sentry/react-native/expo", {
        "organization": "giseop",
        "project": "react-native"
      }],
      "expo-updates",
      "expo-router",
      "expo-font",
      ["expo-image-picker", {
        "photosPermission": "둘다좋아가 일정에 사진을 첨부하기 위해 사진 라이브러리에 접근합니다."
      }],
      "expo-camera",
      "expo-notifications",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFBF7",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2876cc9-17db-46e8-876d-06ee39f442b8"
      }
    },
    "owner": "shingiseop"
  }
}
