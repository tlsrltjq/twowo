rules_version = '2';

// =============================================================================
// 커플 앱 — Firebase Storage Security Rules
// -----------------------------------------------------------------------------
// 경로 규칙 (architecture.md 와 일치)
//   couples/{coupleId}/events/{eventId}/{photoId}_original.jpg
//   couples/{coupleId}/events/{eventId}/{photoId}_thumb.jpg
//
// 원칙
//   1) 인증된 사용자 중, 커플 멤버십을 확인한 사용자만 read/write 허용.
//   2) 업로드 크기는 10MB 이하로 제한 (architecture.md: 평균 500KB 목표).
//   3) 이미지 MIME 타입만 허용.
//   4) 그 외 모든 경로는 차단.
//
// ⚠️  cross-service reads 미작동 이슈 (TODO: ADR 추가 예정)
//   firestore.get() 이 Storage Security Rules 평가 시 항상 null 반환.
//   원인: pair-38a4e.firebasestorage.app 버킷(신형)의 Firebase Storage 서비스 계정에
//         GCP IAM roles/datastore.viewer 가 자동 부여되지 않아 Firestore 호출 자체가 차단됨.
//   임시 조치: isSignedIn() 만으로 허용 (coupleId 는 비추측 랜덤 ID 로 security-by-obscurity).
//   영구 수정 방법:
//     (A) GCP Console → IAM → firebase-storage 서비스 계정에 roles/datastore.viewer 추가, 또는
//     (B) Cloud Functions 에서 Admin SDK 로 멤버십 검증 후 서명 URL 발급 (ADR-030 예정).
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // TODO(ADR-030): cross-service IAM 해결 후 firestore.get() 으로 교체
    //   function isMyCouple(coupleId) {
    //     let couple = firestore.get(/databases/(default)/documents/couples/$(coupleId));
    //     return isSignedIn() && couple.data != null
    //            && couple.data.status == 'active'
    //            && request.auth.uid in couple.data.memberIds;
    //   }
    function isMyCouple(_coupleId) {
      return isSignedIn();
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isReasonableSize() {
      return request.resource.size < 10 * 1024 * 1024; // 10MB
    }

    // 커플 사진 공간
    match /couples/{coupleId}/events/{eventId}/{photoFile} {
      allow read: if isMyCouple(coupleId);
      allow create, update: if isMyCouple(coupleId)
                            && isImage()
                            && isReasonableSize();
      allow delete: if isMyCouple(coupleId);
    }

    // 채팅 이미지
    match /couples/{coupleId}/chat/{imageFile} {
      allow read: if isMyCouple(coupleId);
      allow create, update: if isMyCouple(coupleId)
                            && isImage()
                            && isReasonableSize();
      allow delete: if false;
    }

    // 기본 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
