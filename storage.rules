rules_version = '2';

// =============================================================================
// 커플 앱 — Firebase Storage Security Rules
// -----------------------------------------------------------------------------
// 경로 규칙 (architecture.md 와 일치)
//   couples/{coupleId}/events/{eventId}/{photoId}_original.jpg
//   couples/{coupleId}/events/{eventId}/{photoId}_thumb.jpg
//
// 원칙
//   1) 인증된 사용자 중, 커플 멤버십을 확인한 사용자만 read/write 허용.
//   2) 업로드 크기는 10MB 이하로 제한 (architecture.md: 평균 500KB 목표).
//   3) 이미지 MIME 타입만 허용.
//   4) 그 외 모든 경로는 차단.
//
// 커플 멤버십 검증 (ADR-030)
//   firestore.get() 으로 couples/{coupleId}.memberIds 를 읽는 cross-service 규칙.
//   Storage 서비스 에이전트(...@gcp-sa-firebasestorage.iam.gserviceaccount.com)에
//   'Firebase Rules Firestore Service Agent'(roles/firebaserules.firestoreServiceAgent)
//   역할이 있어야 동작한다. 이 규칙을 처음 배포할 때 Firebase CLI/콘솔이 부여 여부를 묻는다.
//   역할 없이 배포하면 모든 사진 요청이 거부되므로, 배포 순서는 docs/runbook.md 참고.
//   판정 기준은 firestore.rules 의 isMyCouple 과 같다(멤버 여부만, status 미확인 —
//   30일 해제 유예 중에도 기존 사진을 볼 수 있어야 함).
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // ADR-030: 커플 문서의 memberIds 로 멤버십 확인 (문서가 없으면 거부)
    function isMyCouple(coupleId) {
      return isSignedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.memberIds;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isReasonableSize() {
      return request.resource.size < 10 * 1024 * 1024; // 10MB
    }

    // 커플 사진 공간
    match /couples/{coupleId}/events/{eventId}/{photoFile} {
      allow read: if isMyCouple(coupleId);
      allow create, update: if isMyCouple(coupleId)
                            && isImage()
                            && isReasonableSize();
      allow delete: if isMyCouple(coupleId);
    }

    // 채팅 이미지
    match /couples/{coupleId}/chat/{imageFile} {
      allow read: if isMyCouple(coupleId);
      allow create, update: if isMyCouple(coupleId)
                            && isImage()
                            && isReasonableSize();
      allow delete: if false;
    }

    // 오늘의 밥 사진
    match /couples/{coupleId}/food/{photoFile} {
      allow read: if isMyCouple(coupleId);
      allow create, update: if isMyCouple(coupleId)
                            && isImage()
                            && isReasonableSize();
      allow delete: if isMyCouple(coupleId);
    }

    // 기본 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
